# DEMO ONLY — intentionally vulnerable to php2shell (CVE-2026-109618 / 109619).
# Uses PHP 8.4.26 (the last release before the 8.4.27 fix) from the official
# image, plus nginx, and leaves session.upload_progress enabled.
# Run only on an isolated, IP-restricted host. Tear down after the demo.
# Build from the repo root:
#   docker build -f demo/Dockerfile.vuln -t kanboard-vuln .
FROM php:8.4.26-fpm-alpine

# nginx + openssl (self-signed cert at runtime) + the PHP extensions Kanboard needs
RUN apk add --no-cache nginx openssl && \
    curl -fsSL https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions \
        -o /usr/local/bin/install-php-extensions && \
    chmod +x /usr/local/bin/install-php-extensions && \
    install-php-extensions \
        gd mbstring dom simplexml xml xmlwriter ctype session \
        pdo pdo_sqlite pdo_mysql pdo_pgsql zip bcmath sockets posix \
        ldap opcache iconv phar && \
    rm -f /usr/local/bin/install-php-extensions

# Kanboard application code (vendor/ is committed in the repo)
COPY . /var/www/app

# Container config: nginx vhost, php-fpm pool on the socket nginx expects,
# PHP ini with the vulnerable upload_progress precondition, entrypoint.
COPY demo/php-fpm-pool.conf /usr/local/etc/php-fpm.d/zz-kanboard.conf
COPY demo/local.ini         /usr/local/etc/php/conf.d/zz-kanboard.ini
COPY docker/etc/nginx/nginx.conf /etc/nginx/nginx.conf
COPY demo/entrypoint.sh     /usr/local/bin/demo-entrypoint.sh

ARG VERSION=demo-vuln
RUN rm -rf /var/www/app/docker /var/www/app/demo && \
    echo "$VERSION" > /var/www/app/app/version.txt && \
    chmod +x /usr/local/bin/demo-entrypoint.sh

VOLUME ["/var/www/app/data", "/var/www/app/plugins"]
EXPOSE 80 443

HEALTHCHECK --start-period=5s --timeout=5s \
  CMD curl -fsk http://localhost/healthcheck.php || exit 1

ENTRYPOINT ["/usr/local/bin/demo-entrypoint.sh"]
